# With nothing set, Accounts runs in preview mode: everything stays in this browser.

# Supabase: the same project, URL and anon key as Write and Type. Never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where the other ELUM apps live. Defaults: https://writebyelum.netlify.app and https://typebyelum.netlify.app
VITE_ELUM_WRITE_URL=
VITE_ELUM_TYPE_URL=
# The domain Type addresses live on; must match elum.config type_domain. Defaults to type.elum.services
VITE_ELUM_TYPE_DOMAIN=
